{
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "deny": [
      "EnterWorktree",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/*.dec.yaml)",
      "Read(./**/*.dec.yml)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/secrets.json)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/AppData/Roaming/sops/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.ps1\" SessionStart", "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.ps1\" UserPromptSubmit", "timeout": 30 }] }
    ],
    "PreToolUse": [
      { "matcher": "Agent|Task|Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.ps1\" PreToolUse", "timeout": 30 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.ps1\" PostToolUse", "timeout": 30 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.ps1\" Stop", "timeout": 300 }] }
    ]
  },
  "claudeMdExcludes": ["**/services/CLAUDE.md", "**/services/AGENTS.md"],
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } }
  }
}
